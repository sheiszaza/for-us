rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRole(role) {
      return role in ['me', 'her'];
    }

    function validContentList(items, maxSize) {
      return items is list
        && items.size() > 0
        && items.size() <= maxSize;
    }

    function validLiveLocation(data, locationRole) {
      return validRole(locationRole)
        && data.keys().hasOnly(['role', 'latitude', 'longitude', 'accuracy', 'sharing', 'updatedAt'])
        && data.keys().hasAll(['role', 'latitude', 'longitude', 'sharing', 'updatedAt'])
        && data.role == locationRole
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && (!('accuracy' in data) || data.accuracy == null || data.accuracy is number)
        && data.sharing is bool
        && data.updatedAt is timestamp;
    }

    function validGameContent(data) {
      return data.keys().hasOnly([
          'loveQuizQuestions',
          'wouldYouRatherQuestions',
          'truths',
          'dares',
          'wordGuessWords',
          'coupleEmojis',
          'typingPhrases',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasAll([
          'loveQuizQuestions',
          'wouldYouRatherQuestions',
          'truths',
          'dares',
          'wordGuessWords',
          'coupleEmojis',
          'typingPhrases',
          'updatedAt',
          'updatedBy'
        ])
        && validContentList(data.loveQuizQuestions, 100)
        && validContentList(data.wouldYouRatherQuestions, 100)
        && validContentList(data.truths, 100)
        && validContentList(data.dares, 100)
        && validContentList(data.wordGuessWords, 100)
        && validContentList(data.coupleEmojis, 50)
        && data.coupleEmojis.size() >= 8
        && validContentList(data.typingPhrases, 100)
        && data.updatedAt is timestamp
        && data.updatedBy == 'me';
    }

    function validMessageCreate(data) {
      return data.keys().hasAll(['text', 'from', 'createdAt', 'seenByMe', 'seenByHer'])
        && data.keys().hasOnly(['text', 'from', 'createdAt', 'seenByMe', 'seenByHer', 'imageUrl', 'imagePath'])
        && validRole(data.from)
        && data.text is string
        && data.createdAt is timestamp
        && data.seenByMe is bool
        && data.seenByHer is bool
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string)
        && (!('imagePath' in data) || data.imagePath == null || data.imagePath is string);
    }

    match /messages/{messageId} {
      // Only anonymous Firebase users can read/write the private couple chat.
      allow read: if signedIn();
      allow create: if signedIn()
        && validMessageCreate(request.resource.data);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['seenByMe', 'seenByHer'])
        && request.resource.data.seenByMe is bool
        && request.resource.data.seenByHer is bool;
      allow delete: if false;
    }

    match /homeNotes/{targetRole} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validRole(targetRole)
        && request.resource.data.keys().hasOnly(['text', 'fromRole', 'targetRole', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && validRole(request.resource.data.fromRole)
        && request.resource.data.fromRole != targetRole
        && request.resource.data.targetRole == targetRole
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.date is string;
      allow update, delete: if signedIn();
    }

    match /letters/{letterId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.content is string;
      allow update, delete: if signedIn();
    }

    match /countdowns/{countdownId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.targetDate is string;
      allow update, delete: if signedIn();
    }

    match /dateIdeas/{ideaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.status in ['planned', 'upcoming', 'completed'];
      allow update, delete: if signedIn();
    }

    match /settings/nicknames {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (!('me' in request.resource.data) || (request.resource.data.me is string && request.resource.data.me.size() <= 50))
        && (!('her' in request.resource.data) || (request.resource.data.her is string && request.resource.data.her.size() <= 50));
    }

    match /locations/{locationRole} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validLiveLocation(request.resource.data, locationRole);
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.type is string
        && request.resource.data.status in ['waiting', 'playing', 'finished'];
      allow update, delete: if signedIn();
    }

    match /gameHistory/{historyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.type is string;
      allow update, delete: if signedIn();
    }

    match /gameContent/default {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validGameContent(request.resource.data);
      allow delete: if false;
    }
  }
}
