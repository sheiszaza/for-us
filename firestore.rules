rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRole(role) {
      return role in ['me', 'her'];
    }

    function validContentList(items, maxSize) {
      return items is list
        && items.size() > 0
        && items.size() <= maxSize;
    }

    function validGameContent(data) {
      return data.keys().hasOnly([
          'loveQuizQuestions',
          'wouldYouRatherQuestions',
          'truths',
          'dares',
          'wordGuessWords',
          'coupleEmojis',
          'typingPhrases',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasAll([
          'loveQuizQuestions',
          'wouldYouRatherQuestions',
          'truths',
          'dares',
          'wordGuessWords',
          'coupleEmojis',
          'typingPhrases',
          'updatedAt',
          'updatedBy'
        ])
        && validContentList(data.loveQuizQuestions, 100)
        && validContentList(data.wouldYouRatherQuestions, 100)
        && validContentList(data.truths, 100)
        && validContentList(data.dares, 100)
        && validContentList(data.wordGuessWords, 100)
        && validContentList(data.coupleEmojis, 50)
        && data.coupleEmojis.size() >= 8
        && validContentList(data.typingPhrases, 100)
        && data.updatedAt is timestamp
        && data.updatedBy == 'me';
    }

    match /messages/{messageId} {
      // Only anonymous Firebase users can read/write the private couple chat.
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.from)
        && request.resource.data.text is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.seenByMe is bool
        && request.resource.data.seenByHer is bool
        && (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string)
        && (request.resource.data.imagePath == null || request.resource.data.imagePath is string);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['seenByMe', 'seenByHer']);
      allow delete: if false;
    }

    match /homeNotes/{targetRole} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validRole(targetRole)
        && request.resource.data.keys().hasOnly(['text', 'fromRole', 'targetRole', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && validRole(request.resource.data.fromRole)
        && request.resource.data.fromRole != targetRole
        && request.resource.data.targetRole == targetRole
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.date is string;
      allow update, delete: if signedIn();
    }

    match /letters/{letterId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.content is string;
      allow update, delete: if signedIn();
    }

    match /countdowns/{countdownId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.targetDate is string;
      allow update, delete: if signedIn();
    }

    match /dateIdeas/{ideaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.title is string
        && request.resource.data.status in ['planned', 'upcoming', 'completed'];
      allow update, delete: if signedIn();
    }

    match /settings/nicknames {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (!('me' in request.resource.data) || (request.resource.data.me is string && request.resource.data.me.size() <= 50))
        && (!('her' in request.resource.data) || (request.resource.data.her is string && request.resource.data.her.size() <= 50));
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validRole(request.resource.data.createdBy)
        && request.resource.data.type is string
        && request.resource.data.status in ['waiting', 'playing', 'finished'];
      allow update, delete: if signedIn();
    }

    match /gameHistory/{historyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.type is string;
      allow update, delete: if signedIn();
    }

    match /gameContent/default {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validGameContent(request.resource.data);
      allow delete: if false;
    }
  }
}
